# ── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Trading Configuration ────────────────────────────────────────────────────
TRADING_MODE=paper               # paper | live
INITIAL_BALANCE=100000.0         # Starting portfolio balance (USD)
AGENT_INTERVAL_SECONDS=300       # How often the agent runs (seconds)
AGENT_MODEL=claude-sonnet-4-6    # Claude model for agent decisions

# ── Risk Controls ────────────────────────────────────────────────────────────
MAX_POSITION_SIZE_PCT=0.05       # Max 5% of portfolio per trade
MAX_TOTAL_EXPOSURE_PCT=0.30      # Max 30% total notional exposure
MAX_DAILY_LOSS_PCT=0.03          # Halt if daily loss exceeds 3%
MAX_OPEN_POSITIONS=8             # Maximum concurrent open positions
DEFAULT_RISK_REWARD=1.5          # Minimum risk:reward ratio

# ── Market Data ──────────────────────────────────────────────────────────────
MARKET_DATA_MODE=simulation      # simulation | live
ALPHA_VANTAGE_KEY=               # Optional: Alpha Vantage API key for live data

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./fx_trading.db
