# ─────────────────────────────────────────────────────────────────────────────
# David FX Trading Platform — PRODUCTION environment template
# Copy this to .env and fill in all values before deploying.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# ── Security (REQUIRED — leave blank = INSECURE) ──────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_generate_a_random_key
WS_TOKEN=CHANGE_ME_generate_a_random_ws_token

# Comma-separated list of allowed origins for CORS
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=david_fx
POSTGRES_USER=david
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=CHANGE_ME_generate_a_db_password

# DATABASE_URL is set automatically by docker-compose using the above values.
# Only set this directly if running without Docker.
# DATABASE_URL=postgresql+asyncpg://david:password@localhost:5432/david_fx

# ── Trading ───────────────────────────────────────────────────────────────────
TRADING_MODE=paper          # KEEP AS "paper" until fully validated
INITIAL_BALANCE=100000.0
AGENT_INTERVAL_SECONDS=300

# ── Market data ───────────────────────────────────────────────────────────────
MARKET_DATA_MODE=simulation  # "simulation" | "live" (live requires ALPHA_VANTAGE_KEY)
ALPHA_VANTAGE_KEY=           # Free at alphavantage.co (5 req/min on free tier)

# ── Risk limits ───────────────────────────────────────────────────────────────
MAX_DRAWDOWN_PCT=10.0
MAX_POSITION_SIZE_PCT=0.05
MAX_TOTAL_EXPOSURE_PCT=0.30
MAX_DAILY_LOSS_PCT=0.03
MAX_OPEN_POSITIONS=8

# ── Agent model ───────────────────────────────────────────────────────────────
AGENT_MODEL=claude-sonnet-4-6
